# 운영 비밀값 템플릿.
#
# 【쓰는 법】
#   서버에서 이 파일을 .env 로 복사한 뒤 값을 채운다.
#     cp .env.prod.example .env
#     nano .env
#
#   docker compose 는 같은 폴더의 .env 를 자동으로 읽는다.
#   .env 는 .gitignore 에 걸려 있어 커밋되지 않는다. (절대 커밋하지 말 것)
#
# 【값 만드는 법】
#   비밀번호·키는 직접 지어내지 말고 아래 명령으로 만든다.
#     openssl rand -base64 24     ← 비밀번호용
#     openssl rand -base64 48     ← JWT_SECRET 용

# ===== MySQL =====
# root 계정 비밀번호 (앱은 안 쓰고 관리용)
MYSQL_ROOT_PASSWORD=

# 앱이 쓰는 계정. 이름은 그대로 두고 비밀번호만 채우면 된다.
MYSQL_USER=fmatch
MYSQL_PASSWORD=

# ===== Redis =====
REDIS_PASSWORD=

# ===== JWT =====
# 로그인 토큰에 서명하는 키.
#   반드시 32자 이상. 짧으면 백엔드가 기동하다가 실패한다.
#   로컬 개발용 값(application-local.properties)을 그대로 쓰지 말 것.
JWT_SECRET=

# ===== CORS =====
# 프론트와 백엔드가 같은 주소(nginx 뒤)라 실제로는 CORS 가 발생하지 않는다.
# 다만 설정값 자체는 있어야 해서 서버 주소를 적어둔다.
#   예) http://13.125.100.50    나중에 도메인이 생기면 https://내도메인.com
CORS_ALLOWED_ORIGINS=http://서버IP를-여기에

# ===== OpenAI (선택) =====
# 리포트의 'AI 종합 코멘트' 를 만드는 데 쓴다.
#   비워두면 코멘트만 안 만들어지고 나머지 기능은 전부 정상이다.
#   키가 있으면 여기에 넣는다. (유료 API 라 호출할 때마다 비용이 발생한다)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
