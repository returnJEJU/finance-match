<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.financematch.auth.mapper.MemberMapper">

    <!--
      탈퇴(soft delete) 회원도 포함해서 확인한다.
      uk_member_email 은 deleted_at 과 무관하게 걸려 있어, 탈퇴 회원의 이메일도 그대로 점유되어 있다.
      deleted_at IS NULL 로 걸러내면 "사용 가능" 이라고 답한 뒤 INSERT 가 중복 키로 실패한다.
    -->
    <select id="existsByEmail" resultType="boolean">
        SELECT EXISTS (
            SELECT 1
            FROM member
            WHERE email = #{email}
        )
    </select>

    <!--
      status·kb_star_savings_eligible 는 DB 기본값(ACTIVE·0)을 쓴다.
      last_login_at 은 넣지 않는다 — NULL 이어야 첫 로그인 판별(isFirstLogin)이 동작한다.
    -->
    <insert id="insert"
            parameterType="com.financematch.auth.domain.Member"
            useGeneratedKeys="true"
            keyProperty="id"
            keyColumn="id">
        INSERT INTO member (
            email,
            password,
            name,
            gender,
            birth_date
        ) VALUES (
            #{email},
            #{password},
            #{name},
            #{gender},
            #{birthDate}
        )
    </insert>

    <insert id="insertAgreement"
            parameterType="com.financematch.auth.domain.MemberAgreement"
            useGeneratedKeys="true"
            keyProperty="id"
            keyColumn="id">
        INSERT INTO member_agreement (
            member_id,
            agree_mydata_terms,
            agree_privacy,
            agree_asset_link,
            agree_couple_share,
            agree_marketing,
            agreed_at
        ) VALUES (
            #{memberId},
            #{agreeMydataTerms},
            #{agreePrivacy},
            #{agreeAssetLink},
            #{agreeCoupleShare},
            #{agreeMarketing},
            #{agreedAt}
        )
    </insert>

    <!--
      탈퇴 회원은 아예 조회하지 않는다. 결과가 null 이면 서비스가 INVALID_CREDENTIALS 로 처리한다.
      "없는 이메일"·"비밀번호 불일치"·"탈퇴 회원"을 같은 코드로 응답해 계정 열거를 막는다.
      status 는 WITHDRAWN 만 제외한다(DORMANT 휴면 처리는 요구사항 확정 후).
    -->
    <select id="findByEmail" resultType="com.financematch.auth.domain.Member">
        SELECT
            id,
            email,
            password,
            name,
            gender,
            birth_date,
            last_login_at
        FROM member
        WHERE email = #{email}
          AND status != 'WITHDRAWN'
          AND deleted_at IS NULL
    </select>

    <update id="updateLastLoginAt">
        UPDATE member
        SET last_login_at = NOW()
        WHERE id = #{memberId}
    </update>

    <!-- 로그인 회원 자신의 기본 정보. 탈퇴 회원은 조회하지 않는다. -->
    <select id="findById" resultType="com.financematch.auth.domain.Member">
        SELECT
            id,
            email,
            name,
            gender,
            birth_date,
            last_login_at,
            status
        FROM member
        WHERE id = #{memberId}
          AND status != 'WITHDRAWN'
          AND deleted_at IS NULL
    </select>

    <!--
      회원탈퇴 전용. findByEmail 과 달리 탈퇴 회원도 조회한다.
      제외해 버리면 이미 탈퇴한 회원이 "없는 회원"(404)으로 보여 409 를 구분할 수 없다.
    -->
    <select id="findByIdIncludingWithdrawn" resultType="com.financematch.auth.domain.Member">
        SELECT
            id,
            email,
            password,
            name,
            gender,
            birth_date,
            last_login_at,
            status
        FROM member
        WHERE id = #{memberId}
    </select>

    <!--
      soft delete — 행을 지우지 않고 상태만 바꾼다. 커플·설문·리포트·추천이 member_id 를 참조하고 있어
      실제로 지우면 함께 무너진다.

      status != 'WITHDRAWN' 조건은 동시 요청 방어다. 같은 회원의 탈퇴 요청이 두 번 들어와도 두 번째는
      0행이 되어 서비스가 MEMBER_ALREADY_WITHDRAWN 으로 처리한다.

      deleted_at 은 NOW() 가 아니라 파라미터로 받는다 — 응답에 내려줄 시각과 저장된 값이 같아야 하는데,
      NOW() 로 넣으면 그 값을 알기 위해 다시 조회해야 한다. 서비스에서 초 단위로 잘라 넘긴다(이 컬럼은
      소수점 이하가 없는 datetime 이라 자르지 않으면 반올림되어 어긋난다).
    -->
    <update id="withdraw">
        UPDATE member
        SET status = 'WITHDRAWN',
            deleted_at = #{withdrawnAt}
        WHERE id = #{memberId}
          AND status != 'WITHDRAWN'
    </update>
</mapper>
